    font-family: var(--fonte-titulo);
    font-size: 1.5rem;
    font-weight: 600;
    text-align: center;

     /* Interação */
    cursor: pointer;
    overflow: hidden;

    transition:
        transform 0.25s ease,
        filter 0.25s ease,
        border-color 0.25s ease,
